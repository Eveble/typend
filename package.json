  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "author": {
    "name": "Adam Desivi, Eveble",
    "email": "eveble@eveble.com",
    "url": "https://eveble.com"
  },
  "homepage": "https://eveble.github.io/typend/",
  "keywords": [
    "eveble",
    "typend",
    "simplecheck",
    "check",
    "meteor",
    "variable",
    "instanceof",
